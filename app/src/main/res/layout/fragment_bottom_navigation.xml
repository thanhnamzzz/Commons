<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".bottomNavigation.BottomNavigationFragment">

    <!-- Header Control Panel -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo MyBottomNavigationView Module"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentSelection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đang chọn: Tab 0 (Trang chủ)"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Chọn chế độ hiệu ứng Background:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/ll_button_animation"
                style="@style/Widget.Material3Expressive.MaterialButtonToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnModeFade"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fade"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeSpring"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Spring"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeSmooth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Smooth"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggleItemCount"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Số nút (3 ↔ 4)"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnToggleCornerRadius"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đổi Bo Góc (16dp ↔ 100dp)"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleThinEffect"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hiệu ứng mỏng theo độ dài: Bật (Chuẩn 1.0x)"
                android:textSize="11sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ViewPager2 nằm ở giữa -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- CUSTOM BOTTOM NAVIGATION VIEW TỪ MODULE myBottomNavigation -->
    <common.libs.bottomNavigation.MyBottomNavigationView
        android:id="@+id/myBottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_rounded_card"
        app:barElevation="@dimen/_3sdp"
        app:barPadding="8dp"
        app:indicatorAnimationMode="slideSpring"
        app:indicatorSpringTension="1.1"
        app:indicatorThinFactor="0.6"
        app:itemCornerRadius="14dp"
        app:itemFontFamily="@font/montserrat_alternates_medium"
        app:itemIconSize="@dimen/_18sdp"
        app:itemIconTitleSpacing="@dimen/_2sdp"
        app:itemSpacing="@dimen/_2sdp"
        app:itemUnselectedBackground="#0D000000" />

</LinearLayout>