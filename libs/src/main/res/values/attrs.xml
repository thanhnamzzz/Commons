<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="StrokeTextView">
        <attr name="strokeTextColor" format="color" />
        <attr name="strokeBorderColor" format="color" />
        <attr name="strokeBorderWidth" format="float" />
        <attr name="strokeBorderJoin" format="enum">
            <enum name="MITER" value="0" />
            <enum name="ROUND" value="1" />
            <enum name="BEVEL" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="GradientBackgroundButton">
        <attr name="button_color1" format="color" />
        <attr name="button_color2" format="color" />
        <attr name="button_color3" format="color" />
        <attr name="button_color4" format="color" />
        <attr name="button_color5" format="color" />
        <attr name="orientationColor" format="enum">
            <enum name="TOP_BOTTOM" value="0" />
            <enum name="TR_BL" value="1" />
            <enum name="RIGHT_LEFT" value="2" />
            <enum name="BR_TL" value="3" />
            <enum name="BOTTOM_TOP" value="4" />
            <enum name="BL_TR" value="5" />
            <enum name="LEFT_RIGHT" value="6" />
            <enum name="TL_BR" value="7" />
        </attr>
        <attr name="cornerRadius" format="dimension" />
        <attr name="strokeWidth" format="dimension" />
        <attr name="strokeColor" format="color" />
        <attr name="rippleColor" format="color" />
    </declare-styleable>

    <declare-styleable name="GradientTextView">
        <attr name="text_color1" format="color" />
        <attr name="text_color2" format="color" />
        <attr name="text_color3" format="color" />
        <attr name="text_color4" format="color" />
        <attr name="text_color5" format="color" />
        <attr name="orientationColorTextView" format="enum">
            <enum name="HORIZONTAL" value="0" />
            <enum name="VERTICAL" value="1" />
            <enum name="DIAGONAL" value="2" />
        </attr>
    </declare-styleable>
    <declare-styleable name="ProgressWheel">
        <attr name="pw_progressIndeterminate" format="boolean" />
        <attr name="pw_barColor" format="color" />
        <attr name="pw_rimColor" format="color" />
        <attr name="pw_rimWidth" format="dimension" />
        <attr name="pw_spinSpeed" format="float" />
        <attr name="pw_barSpinCycleTime" format="integer" />
        <attr name="pw_circleRadius" format="dimension" />
        <attr name="pw_fillRadius" format="boolean" />
        <attr name="pw_barWidth" format="dimension" />
        <attr name="pw_linearProgress" format="boolean" />
        <attr name="pw_borderProgress" format="boolean" />
    </declare-styleable>

    <declare-styleable name="FlowLayout">
        <attr name="flFlow" format="boolean" />
        <attr name="flChildSpacing" format="enum|dimension">
            <enum name="auto" value="-65536" />
        </attr>
        <attr name="flMinChildSpacing" format="dimension" />
        <attr name="flChildSpacingForLastRow" format="enum|dimension">
            <enum name="auto" value="-65536" />
            <enum name="align" value="-65537" />
        </attr>
        <attr name="flRowSpacing" format="enum|dimension">
            <enum name="auto" value="-65536" />
        </attr>
        <attr name="flRtl" format="boolean" />
        <attr name="flMaxRows" format="integer" />
        <attr name="flRowVerticalGravity" format="enum">
            <enum name="auto" value="-65536" />
            <enum name="top" value="0x30" />
            <enum name="center" value="0x10" />
            <enum name="bottom" value="0x50" />
        </attr>
        <attr name="android:gravity" />
    </declare-styleable>

    <declare-styleable name="ShimmerView">
        <attr name="reflectionColor" format="color" />
    </declare-styleable>

    <declare-styleable name="IslandNavigationBarView">
        <attr name="barMenu" format="reference" />
        <attr name="barSelectedTab" format="integer" />
        <attr name="barTabToggleDuration" format="integer" />
        <attr name="barToggleInterpolator" format="reference" />
        <attr name="barDistribution" format="enum">
            <enum name="spread" value="0" />
            <enum name="packed" value="1" />
            <enum name="spread_inside" value="2" />
        </attr>
        <attr name="barHiddenTitleTab" format="boolean" />
    </declare-styleable>

    <declare-styleable name="IslandNavigationTabView">
        <attr name="tabTitle" format="reference|string" />
        <attr name="tabTitleFont" format="reference" />
        <attr name="tabTitleSize" format="dimension" />
        <attr name="tabIcon" format="reference" />
        <attr name="tabBackground" format="reference" />
        <attr name="tabToggleDuration" format="integer" />
        <attr name="tabTitleActiveColor" format="reference|color" />
        <attr name="tabTitleInactiveColor" format="reference|color" />
        <attr name="tabCustomPadding" format="dimension|reference" />
        <attr name="tabIconSize" format="dimension" />
    </declare-styleable>

    <declare-styleable name="TransitionButton">
        <attr name="defaultColor" format="string" />
        <attr name="loaderColor" format="string" />
        <attr name="errorColor" format="string" />
    </declare-styleable>

    <declare-styleable name="IndicatorManual">
        <attr name="indicatorCount" format="integer" />
        <attr name="indicatorSelectedColor" format="color" />
        <attr name="indicatorUnselectedColor" format="color" />
        <attr name="indicatorRadius" format="dimension" />
        <attr name="indicatorSpacing" format="dimension" />
        <attr name="indicatorSelectedIndex" format="integer" />
        <attr name="indicatorSelectedDrawable" format="reference" />
        <attr name="indicatorUnselectedDrawable" format="reference" />
    </declare-styleable>
    <declare-styleable name="MyBottomNavigationView">
        <!-- Chế độ hiệu ứng chuyển đổi background: fade (mặc định), slideSpring, slideSmooth, none -->
        <attr name="indicatorAnimationMode" format="enum">
            <enum name="fade" value="0" />
            <enum name="slideSpring" value="1" />
            <enum name="slideSmooth" value="2" />
            <enum name="none" value="3" />
        </attr>

        <!-- Thời gian chạy animation chuyển tab (ms) -->
        <attr name="indicatorDuration" format="integer" />

        <!-- Độ nảy vật lý (Spring/Overshoot Tension) cho chế độ slideSpring (mặc định 1.3) -->
        <attr name="indicatorSpringTension" format="float" />

        <!-- Hiệu ứng làm mỏng chiều cao background theo độ dài di chuyển và nở ra khi dừng lại -->
        <attr name="indicatorThinOnMove" format="boolean" />
        <attr name="indicatorThinFactor" format="float" />

        <!-- Background / Lớp phủ cho item được chọn (dạng drawable hoặc color) -->
        <attr name="itemSelectedBackground" format="reference|color" />

        <!-- Background / Lớp phủ cho item KHÔNG được chọn (dạng drawable hoặc color) -->
        <attr name="itemUnselectedBackground" format="reference|color" />

        <!-- Góc bo tròn của lớp phủ khi item được chọn (dp) -->
        <attr name="itemCornerRadiusSelected" format="dimension" />

        <!-- Góc bo tròn của lớp phủ khi item không được chọn (dp) -->
        <attr name="itemCornerRadiusUnselected" format="dimension" />

        <!-- Góc bo tròn chung cho cả chọn và không chọn nếu không định nghĩa riêng (dp) -->
        <attr name="itemCornerRadius" format="dimension" />

        <!-- Khoảng cách riêng biệt giữa các Item liền kề (dp) -->
        <attr name="itemSpacing" format="dimension" />

        <!-- Padding đệm giữa viền ngoài của View cha (parent) với nội dung bên trong (dp) -->
        <attr name="barPadding" format="dimension" />
        <attr name="barPaddingHorizontal" format="dimension" />
        <attr name="barPaddingVertical" format="dimension" />

        <!-- Khoảng đệm thu nhỏ nội bộ của indicator bên trong ô item (dp, mặc định 0dp) -->
        <attr name="indicatorPaddingHorizontal" format="dimension" />
        <attr name="indicatorPaddingVertical" format="dimension" />

        <!-- Tương thích ngược (alias cho indicatorPadding) -->
        <attr name="indicatorMarginHorizontal" format="dimension" />
        <attr name="indicatorMarginVertical" format="dimension" />

        <!-- Kích thước mặc định của Icon (dp) -->
        <attr name="itemIconSize" format="dimension" />

        <!-- Khoảng cách giữa Icon và Text Title (dp) -->
        <attr name="itemIconTitleSpacing" format="dimension" />

        <!-- Font chữ tùy biến áp dụng chung cho tất cả các tab -->
        <attr name="itemFontFamily" format="reference" />

        <!-- Độ nâng/Đổ bóng của thanh Bar (dp) -->
        <attr name="barElevation" format="dimension" />
    </declare-styleable>
</resources>